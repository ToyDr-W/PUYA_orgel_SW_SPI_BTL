;==============================================
;音符終了
;==============================================
	macro
	onp_end
	dcw	0x0000
	mend

;==============================================
;転調設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:転調度[半音階]
;ｶﾚﾝﾄの調からの転調度を指定する(-15～+15)
;0のときはSONGﾃﾞｰﾀ中の移調設定値に戻す
;==============================================
	macro
	kec_mac	$kkk
	dcw	0x0020+(($kkk)&0x1f)
	mend

;==============================================
;ﾘﾋﾟｰﾄ1の回数設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾘﾋﾟｰﾄ回数(2～16)
;==============================================
	macro
	rp1_mac	$rrr
	dcw	0x0040+((($rrr)-1)&0x0f)
	mend

;==============================================
;ﾘﾋﾟｰﾄ2の回数設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾘﾋﾟｰﾄ回数(2～16)
;==============================================
	macro
	rp2_mac	$rrr
	dcw	0x0050+((($rrr)-1)&0x0f)
	mend

;==============================================
;ﾘﾋﾟｰﾄ3の回数設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾘﾋﾟｰﾄ回数(2～16)
;==============================================
	macro
	rp3_mac	$rrr
