	mend

;==============================================
;無条件分岐ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:分岐先の音符ﾃﾞｰﾀﾃｰﾌﾞﾙのﾜｰﾄﾞｵﾌｾｯﾄ値
;　無条件に分岐する
;==============================================
	macro
	jmp_mac	$jjj
	dcw	0x3000+((($jjj)/2)&0x3ff)
	mend

;==============================================
;ﾍﾞﾛｼﾃｨ設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾍﾞﾛｼﾃｨ値(全ﾊﾟｰﾄの合計が255以下になること､0は最小､255は最大)
;==============================================
	macro
	vel_mac	$vvv
	dcw	0x3400+((ORGEL_VOL*$vvv/100)&0xff)
	mend

;==============================================
;ｴﾝﾍﾞﾛｰﾌﾟﾀｲﾑ設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ｴﾝﾍﾞﾛｰﾌﾟﾀｲﾑのﾌﾟﾘｽｹｰﾙ値
;==============================================
	macro
	env_mac	$eee
	dcw	0x3500+(($eee)&0xff)
	mend

;==============================================
;ﾃﾝﾎﾟ設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾃﾝﾎﾟ変化率[%](51～200の範囲であること)
;==============================================
	macro
	tmp_mac	$ttt
	dcw	0x3600+((12750/($ttt))&0xff)
	mend

