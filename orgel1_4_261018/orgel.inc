	mend

;==============================================
;ﾘﾋﾟｰﾄ4の回数設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾘﾋﾟｰﾄ回数(2～16)
;==============================================
	macro
	rp4_mac	$rrr
	dcw	0x0070+((($rrr)-1)&0x0f)
	mend

;==============================================
;演奏音符設定ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ
;　ttt:ﾀｲ･ｽﾗｰ･ﾎﾟﾙﾀﾒﾝﾄ(0=無し､1=TIE(ﾀｲ･ｽﾗｰ)､2=POL(ﾎﾟﾙﾀﾒﾝﾄ))
;　kkk:音価ｺｰﾄﾞ(1起算)
;　ooo:ｵｸﾀｰﾌﾞ番号(0起算)
;　nnn:音名ｺｰﾄﾞ(0起算)
;特例)ttt=2､kkk=0はﾎﾟﾙﾀﾒﾝﾄ終点の音高をoooとnnnで示し､ﾎﾟﾙﾀﾒﾝﾄ音符の直後に置くこと
;==============================================
	macro
	onp_mac	$ttt,$kkk,$ooo,$nnn
	dcw	($kkk&0x1f)*256+(($ttt)&0x03)*64+(($ooo*12+$nnn)&0x7f)
	mend

;==============================================
;効果音発声ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ
;　kkk:音価ｺｰﾄﾞ(1起算)
;　aaa:効果音波形ﾃﾞｰﾀｱﾄﾞﾚｽ
;　sss:ｻﾝﾌﾟﾙﾚｰﾄ[sps]
;==============================================
	macro
	efw_mac	$kkk,$aaa,$sss
	dcw	0x4000+($kkk&0x1f)*256+(((($sss*PWM_PR*SONG_PS/1000)*256)/1000)&0xff)
	mend
	macro
	efa_mac	$kkk,$aaa,$sss
	dcw	$aaa-SONG_IDX
	mend

;==============================================
;ﾘﾋﾟｰﾄ1の分岐ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:分岐先の音符ﾃﾞｰﾀﾃｰﾌﾞﾙのﾜｰﾄﾞｵﾌｾｯﾄ値
;　ﾘﾋﾟｰﾄ回数をﾃﾞｸﾘして0でなければ分岐する､0になったら次の音符ﾃﾞｰﾀへ進む
;==============================================
	macro
	jp1_mac	$jjj
	dcw	0x2000+((($jjj)/2)&0x3ff)
	mend

;==============================================
;ﾘﾋﾟｰﾄ2の分岐ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:分岐先の音符ﾃﾞｰﾀﾃｰﾌﾞﾙのﾜｰﾄﾞｵﾌｾｯﾄ値
;　ﾘﾋﾟｰﾄ回数をﾃﾞｸﾘして0でなければ分岐する､0になったら次の音符ﾃﾞｰﾀへ進む
;==============================================
	macro
	jp2_mac	$jjj
	dcw	0x2400+((($jjj)/2)&0x3ff)
	mend

