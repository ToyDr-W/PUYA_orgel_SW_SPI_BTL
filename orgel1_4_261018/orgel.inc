;==============================================
;songﾃﾞｰﾀとonpuﾃﾞｰﾀの標準化のための設定
;==============================================
NULL	equ	0

	macro
	bgn_mac
	align	4
	mend

	macro
	end_mac
	mend

	macro
	asb_mac	
	mend

	macro
	ase_mac	
	mend

SONG_IDX_SZ	equ	4

;==============================================
;曲ｲﾝﾃﾞｯｸｽ生成ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:SONG_HDRのﾗﾍﾞﾙ
;==============================================
	macro
	son_mac	$aaa,$bbb
	dcd	$aaa-SONG_IDX
$bbb
	mend

;==============================================
;音価ﾌﾟﾘｽｹｰﾙ値生成ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾃﾝﾎﾟ値[4分音符/分]
;　音価ﾌﾟﾘｽｹｰﾙ値とは音価の基本単位にしている4分音符の1/48の時間を
;　　演奏処理周期(PWM_PR*SONG_PS)をﾍﾞｰｽに作るためのﾌﾟﾘｽｹｰﾙ値
;　　=60*1000000us/ﾃﾝﾎﾟ/48/(PWM_PR*SONG_PS)
;==============================================
	macro
	ops_mac	$ttt
	dcw	(100000000/($ttt)/PWM_PR/SONG_PS/8+5)/10
	mend

;==============================================
;移調設定値生成ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:移調設定値=共通音高ﾃｰﾌﾞﾙを基準とした移調度[半音階](-15～15)
;==============================================
	macro
	kys_mac	$kkk
	dcb	$kkk
	mend

;==============================================
;ﾊﾟｰﾄ数生成ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾊﾟｰﾄ数(1～4)
;==============================================
	macro
	pns_mac	$nnn
	dcb	$nnn
	mend

;==============================================
;ｴﾝﾍﾞﾛｰﾌﾟ処理ﾀｲﾐﾝｸﾞﾌﾟﾘｽｹｰﾙ値生成ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ｴﾝﾍﾞﾛｰﾌﾟ処理周期[us]
;　ｴﾝﾍﾞﾛｰﾌﾟ処理周期を演奏処理周期に対するﾌﾟﾘｽｹｰﾙ値に変換する
;　このﾌﾟﾘｽｹｰﾙに更に音符ﾃﾞｰﾀ中のenv_macで指定するﾌﾟﾘｽｹｰﾙを被せて
;　実際のｴﾝﾍﾞﾛｰﾌﾟ処理ﾀｲﾐﾝｸﾞになる
;==============================================
	macro
	eps_mac	$eee
	dcd	(10*($eee)/PWM_PR/SONG_PS+5)/10
	mend

;==============================================
;ﾋﾟｯﾁﾍﾞﾝﾄﾞ処理ﾀｲﾐﾝｸﾞﾌﾟﾘｽｹｰﾙ値生成ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾋﾟｯﾁﾍﾞﾝﾄﾞ処理周期[us]
;　ﾋﾟｯﾁﾍﾞﾝﾄﾞ処理周期を演奏処理周期に対するﾌﾟﾘｽｹｰﾙ値に変換する
;　このﾌﾟﾘｽｹｰﾙに更に音符ﾃﾞｰﾀ中のpit_macで指定するﾌﾟﾘｽｹｰﾙを被せて
;　実際のﾋﾟｯﾁﾍﾞﾝﾄﾞ処理ﾀｲﾐﾝｸﾞになる
;==============================================
	macro
	pps_mac	$ppp
	dcd	(10*($ppp)/PWM_PR/SONG_PS+5)/10
	mend

;==============================================
;ﾎﾟｲﾝﾀﾃｰﾌﾞﾙ生成ﾏｸﾛ
;　ﾊﾟﾗﾒｰﾀ:ﾃｰﾌﾞﾙの先頭ﾗﾍﾞﾙ
;==============================================
	macro
	ptr_mac	$ppp
	IF	$ppp=0
	dcd	0
	ELSE
	dcd	$ppp-SONG_IDX
	ENDIF
	mend

;==============================================
;音価記号の定義
;==============================================
k0	equ	0	;発音時間無し
kR32	equ	1	;32分3連符
kR16	equ	2	;16分3連符
kK32	equ	3	;32分音符
kR8	equ	4	;8分3連符
kP32	equ	5	;付点32分音符
kK16	equ	6	;16分音符
kR4	equ	7	;4分3連符
kP16	equ	8	;付点16分音符
kK8	equ	9	;8分音符
kR2	equ	10	;2分3連符
kP8	equ	11	;付点8分音符
kK4	equ	12	;4分音符
kR1	equ	13	;全3連符
kP4	equ	14	;付点4分音符
kK2	equ	15	;2分音符
kP2	equ	16	;付点2分音符
kK1	equ	17	;全音符
kW80	equ	18	;80
kW84	equ	19	;84
kW168	equ	20	;168
kW255	equ	21	;255


